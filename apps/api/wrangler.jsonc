{
    "$schema": "node_modules/wrangler/config-schema.json",
    "upload_source_maps": true,
    "name": "deplodash",
    "account_id": "72d09b5a9d3d9262c9795f34c84d8e79",
    "compatibility_date": "2026-03-17",
    "routes": [
        {
            "pattern": "deplodash.euroka.moe",
            "custom_domain": true
        }
    ],
    "main": "./src/index.ts",
    "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
    },
    "send_metrics": false,
    "observability": {
        "enabled": true
    },
    "vars": {
        "GITHUB_CLIENT_ID": "Iv23li3WmDEd5eJbm4fO",
        "CALLBACK_URL": "https://deplodash.euroka.moe/callback",
        "GITHUB_APP_ID": "4054947",
        "OIDC_ISSUER": "https://deplodash.euroka.moe"
    },
    "secrets": {
        "required": [
            "GITHUB_CLIENT_SECRET",
            "ENCRYPTION_SECRET",
            "GITHUB_APP_PRIVATE_KEY"
        ]
    },
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "96e64895db814394b2b7973168ae9cd5"
        }
    ],
    "ratelimits": [
        {
            "name": "TOKEN_RATE_LIMITER",
            "namespace_id": "157473395730",
            "simple": {
                "limit": 10,
                "period": 10
            }
        }
    ]
}
